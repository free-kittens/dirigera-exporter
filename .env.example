# Copy to .env and fill with your Dirigera hub details
# IP/Host of your Dirigera hub (e.g. 192.168.1.10)
DIRIGERA_HOST=192.168.1.10
# API token for the hub
DIRIGERA_TOKEN=your_api_token_here
# Optional: polling interval in seconds (default 30)
POLL_INTERVAL=30
# Metrics server port (default 8000)
METRICS_PORT=8000
